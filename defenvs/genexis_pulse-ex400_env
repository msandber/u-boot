ipaddr=192.168.1.1
serverip=192.168.1.2
fdtaddr=0x84000000
loadaddr=0x85000000
bootcmd=run boot_ubi
bootdelay=0
bootfile=/tftp/openwrt-ramips-mt7621-genexis_pulse-ex400-initramfs-kernel.bin
bootfile_uboot=/tftp/u-boot-mt7621.bin
bootmenu_confirm_return=askenv - Press ENTER to return to menu ; bootmenu 60
bootmenu_default=0
bootmenu_delay=0
bootmenu_title=      [0;34m( ( ( [1;39mOpenWrt[0;34m ) ) )[0m
bootmenu_0=Initialize environment.=run _firstboot
bootmenu_0d=Run default boot command.=run boot_default
bootmenu_1=Boot system via TFTP.=run boot_tftp ; run bootmenu_confirm_return
bootmenu_2=Boot system from flash.=run boot_ubi ; run bootmenu_confirm_return
bootmenu_3=[31mLoad U-Boot via TFTP then write to flash.[0m=run boot_tftp_write_uboot ; run bootmenu_confirm_return
bootmenu_4=Reset all settings to factory defaults.=run reset_factory ; reset
bootmenu_5=Reboot.=reset
boot_first=if button reset ; then run boot_tftp ; setenv flag_recover 1 ; run boot_default ; fi ; bootmenu
boot_default=if env exists flag_recover ; then else run bootcmd ; fi ; run boot_tftp_forever
boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr
boot_tftp_forever=while true ; do run boot_tftp ; sleep 1 ; done
boot_tftp_write_uboot=tftpboot $loadaddr $bootfile_uboot && run nand_write_uboot
boot_ubi=ubifsmount ubi0:rootfs_0 ; ubifsload $loadaddr /boot/uImage ; if ubifsload $fdtaddr /boot/dtb ; then bootm $loadaddr - $fdtaddr ; fi ;
boot_uboot=tftpboot 0x80200000 /tftp/u-boot.bin && go 0x80200000
init_env=env export -t -s 0x20 $loadaddr ethaddr && env default -a ; env import -t $loadaddr 0x20 ethaddr
reset_factory= run init_env ; saveenv
nand_write_uboot=nand erase 0 0x100000 && nand write $loadaddr 0 $filesize
_firstboot=setenv _firstboot ; run _switch_to_menu ; run boot_first
_switch_to_menu=setenv _switch_to_menu ; setenv bootdelay 3 ; setenv bootmenu_delay 3 ; setenv bootmenu_0 $bootmenu_0d ; setenv bootmenu_0d ; run _bootmenu_update_title
_bootmenu_update_title=setenv _bootmenu_update_title ; setenv bootmenu_title "$bootmenu_title       [33m$ver[0m"
